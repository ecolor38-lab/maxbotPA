# MAX MESSENGER BOT - CONFIGURATION TEMPLATE
MAX_BOT_TOKEN=your_bot_token_here
MAX_CHAT_LINK=https://max.ru/your_channel_link
MAX_BOT_LINK=https://max.ru/your_bot_link
# MAX_CHAT_ID=123456789  # Определяется автоматически по ссылке

# AI API (нужен хотя бы один)
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_API_KEY=sk-...

# Расписание публикаций
CRON_SCHEDULE_1=0 9 * * *
CRON_SCHEDULE_2=0 14 * * *
CRON_SCHEDULE_3=0 19 * * *

# Настройки
TIMEZONE=Asia/Irkutsk
LANGUAGE=ru
MAX_NEWS_ITEMS=5
SEARCH_DAYS_BACK=7
POSTS_PER_BATCH=3

# ЮKassa
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_RETURN_URL=http://141.98.235.39:3000/payment-success

# AI Chat лимиты
CHAT_FREE_DAILY_LIMIT=10
CHAT_PREMIUM_DAILY_LIMIT=100
CHAT_CONTEXT_MESSAGES=10

# Сервер
PORT=3000
PUBLIC_URL=http://141.98.235.39:3000
AUTO_START_SCHEDULER=false
NODE_ENV=development
